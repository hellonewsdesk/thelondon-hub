# Shared secret for the on-demand revalidation route. WordPress calls it from a
# publish_post hook so new articles appear immediately instead of waiting for ISR.
#   https://<your-domain>/api/revalidate/    <- trailing slash required
REVALIDATE_SECRET=change-me

# IndexNow key (32 hex chars). Served at /<key>.txt, submitted with new URLs.
INDEXNOW_KEY=change-me

# Which site config to use when there is no usable Host header: local dev, CLI
# scripts, build-time rendering. Must match a hostname key in config/sites.ts.
NEXT_PUBLIC_DEFAULT_HOST=thelondonhub.co.uk

# WP API bases are NOT here. They live in config/sites.ts, keyed by hostname.
# No tool or page may require any other env var.
