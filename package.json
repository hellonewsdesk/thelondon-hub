{
  "name": "londonhub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.ts",
    "test": "vitest run",
    "perf:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/perf-check.ts",
    "urls:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/wp-url-inventory.ts",
    "cat:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/category-audit.ts",
    "seo:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-schema.ts",
    "indexnow:keys": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/indexnow-keys.ts",
    "prebuild": "npm run indexnow:keys",
    "test:nokeys": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-nokeys.ts",
    "seo:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seo-check.ts"
  },
  "dependencies": {
    "isomorphic-dompurify": "^4.2.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
